// Pop Hotspot — let the desktop user toggle ONLY the hotspot unit without a
// password prompt, so the app's switch can drive the root-owned hostapd AP.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.systemd1.manage-units") &&
        action.lookup("unit") == "pop-hotspot-ap.service" &&
        subject.user == "@USER@") {
        return polkit.Result.YES;
    }
});
