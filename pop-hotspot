CONFIG_DIR = os.path.expanduser("~/.config/pop-hotspot")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
BLOCKED_FILE = os.path.join(CONFIG_DIR, "blocked.json")

def load_json(path, default):
    try:
        with open(path) as f: return json.load(f)
    except: return default

def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f: json.dump(data, f, indent=2)

config = load_json(CONFIG_FILE, {"ssid": "PopOS-Hotspot", "password": "popos1234", "band": "bg"})
blocked = load_json(BLOCKED_FILE, [])
save_json(CONFIG_FILE, config)
save_json(BLOCKED_FILE, blocked)

CONN_NAME = "PopHotspot"

def run_cmd(cmd, timeout=10, cwd=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)
    except:
        return None

last_error = ""

def detect_wifi_iface():
    """First Wi-Fi interface NetworkManager knows about (works for USB dongles too)."""
    r = run_cmd(["nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"])
    if r and r.returncode == 0:
        for line in (r.stdout or "").splitlines():
            dev, _, typ = line.partition(":")
            if typ.strip() == "wifi" and not dev.strip().startswith("p2p"):
                return dev.strip()
    return "wlo1"

WIFI_IFACE = detect_wifi_iface()

# 5 GHz channels that are safe for an access point in Kenya (no DFS, no "no IR")
GHZ5_AP_CHANNELS = ["36", "40", "44", "48", "149", "153", "157", "161"]

def ghz5_channels():
    """Parse `iw list` -> [(channel, usable_as_ap)] for the 5 GHz band."""
    r = run_cmd(["iw", "list"])
    if not r or r.returncode != 0:
        return []
    in_band, out = False, []
    for line in r.stdout.splitlines():
        s = line.strip()
        if s.startswith("Band 2"):
            in_band = True; continue
        if s.startswith("Band ") and not s.startswith("Band 2"):
            in_band = False; continue
        if in_band and s.startswith("*") and "MHz" in s:
            m = re.search(r"\[(\d+)\]", s)
            if m:
                out.append((m.group(1), "no IR" not in s and "radar detection" not in s))
    return out

def ghz5_status():
    """(usable_channels, total_channels, hint)"""
    chans = ghz5_channels()
    if not chans:
        return [], 0, "This Wi-Fi card reports no 5 GHz channels."
    usable = [c for c, ok in chans if ok]
    if usable:
        return usable, len(chans), ""
    return [], len(chans), ("The driver is holding 5 GHz in “no IR” state "
                            "(no initiate radiation), so no access point can start there.")

def is_hotspot_active():
    if hostapd_service_active():
        return True
    r = run_cmd(["nmcli", "-t", "-f", "NAME,STATE", "connection", "show"])
    if r and r.returncode == 0:
        for line in r.stdout.splitlines():
            parts = line.split(":")
            if len(parts) >= 2 and parts[0] == CONN_NAME:
                return parts[1] == "activated"
    return False

# ---------------------------------------------------------------------------
# AP backends
#   hostapd       — real AP daemon; the only one picky clients (TVs) accept.
#                   Runs as the system service pop-hotspot-ap (root, started
#                   without a password via a polkit rule scoped to that unit).
#   networkmanager— NM's AP mode (wpa_supplicant). Fine for phones/laptops,
#                   refused by many TVs. Kept as a fallback.
# ---------------------------------------------------------------------------
HOSTAPD_SERVICE = "pop-hotspot-ap"
HOSTAPD_CONF = os.path.expanduser("~/.local/share/pop-hotspot/hostapd.conf")

def hostapd_backend_available():
    r = run_cmd(["systemctl", "list-unit-files", f"{HOSTAPD_SERVICE}.service"], timeout=8)
    return bool(r and r.returncode == 0 and HOSTAPD_SERVICE in (r.stdout or ""))

def hostapd_service_active():
    r = run_cmd(["systemctl", "is-active", HOSTAPD_SERVICE], timeout=8)
    return bool(r and (r.stdout or "").strip() == "active")

def write_hostapd_conf():
    """Render hostapd.conf from the app's settings so Save && Recreate applies."""
    band = str(config.get("band", "auto"))
    chan = str(config.get("channel") or "auto").strip()
    if band == "a" and chan.isdigit() and int(chan) > 14:
        hw_mode, channel = "a", chan
    else:
        hw_mode, channel = "g", chan if chan.isdigit() and 1 <= int(chan) <= 13 else "6"
    conf = (
        f"interface={WIFI_IFACE}\n"
        "driver=nl80211\n"
        f"ssid={config['ssid']}\n"
        f"hw_mode={hw_mode}\n"
        f"channel={channel}\n"
        "ieee80211n=1\n"
        "wmm_enabled=1\n"
        "auth_algs=1\n"
        "wpa=2\n"
        f"wpa_passphrase={config['password']}\n"
        "wpa_key_mgmt=WPA-PSK\n"
        "rsn_pairwise=CCMP\n"
        "country_code=KE\n"
        "logger_syslog=-1\n"
        "logger_syslog_level=1\n"
        "ctrl_interface=/run/hostapd\n"
        "ctrl_interface_group=0\n"
    )
    os.makedirs(os.path.dirname(HOSTAPD_CONF), exist_ok=True)
    with open(HOSTAPD_CONF, "w") as f:
        f.write(conf)
    return True

def conn_exists():
    r = run_cmd(["nmcli", "-t", "-f", "NAME", "connection", "show"])
    return r and CONN_NAME in r.stdout

def get_clients():
    r = run_cmd(["iw", "dev", WIFI_IFACE, "station", "dump"])
    if not r or r.returncode != 0:
        return {}
    clients = {}
    cur_mac = None
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            cur_mac = None; continue
        if line.startswith("Station"):
            cur_mac = line.split()[1]
            clients[cur_mac] = {"mac": cur_mac, "signal": "", "rx": "", "tx": "", "ip": ""}
        elif cur_mac:
            parts = line.split()
            if line.startswith("signal:"):
                clients[cur_mac]["signal"] = parts[1] if len(parts) > 1 else ""
            elif "rx bytes:" in line:
                tok = line.split()
                if len(tok) >= 1:
                    clients[cur_mac]["rx"] = tok[-1]
            elif "tx bytes:" in line:
                tok = line.split()
                if len(tok) >= 1:
                    clients[cur_mac]["tx"] = tok[-1]
    if clients:
        arp_r = run_cmd(["ip", "neigh", "show", "dev", WIFI_IFACE])
        if arp_r and arp_r.returncode == 0:
            for line in arp_r.stdout.splitlines():
                parts = line.split()
                if len(parts) >= 3 and parts[1] == "lladdr":
                    ip = parts[0]
                    mac = parts[2]
                    if mac in clients:
                        clients[mac]["ip"] = ip
        for mac in clients:
            if not clients[mac].get("ip"):
                clients[mac]["ip"] = "N/A"
    return clients

def apply_iptables_block():
    run_cmd(["iptables", "-F", "POP_HOTSPOT_BLOCK"])
    run_cmd(["iptables", "-X", "POP_HOTSPOT_BLOCK"])
    run_cmd(["iptables", "-N", "POP_HOTSPOT_BLOCK"])
    for mac in blocked:
        run_cmd(["iptables", "-A", "POP_HOTSPOT_BLOCK",
                 "-m", "mac", "--mac-source", mac, "-j", "DROP"])
        run_cmd(["iptables", "-A", "POP_HOTSPOT_BLOCK",
                 "-i", WIFI_IFACE, "-m", "mac", "--mac-source", mac, "-j", "DROP"])
    run_cmd(["iptables", "-I", "FORWARD", "-j", "POP_HOTSPOT_BLOCK"])
    run_cmd(["iptables", "-I", "INPUT", "-j", "POP_HOTSPOT_BLOCK"])

def clear_iptables_block():
    run_cmd(["iptables", "-D", "FORWARD", "-j", "POP_HOTSPOT_BLOCK"])
    run_cmd(["iptables", "-D", "INPUT", "-j", "POP_HOTSPOT_BLOCK"])
    run_cmd(["iptables", "-F", "POP_HOTSPOT_BLOCK"])
    run_cmd(["iptables", "-X", "POP_HOTSPOT_BLOCK"])

def deauth_client(mac):
    run_cmd(["iw", "wlo1", "station", "set", mac, "action", "deauth"])

def reset_wifi_iface():
    run_cmd(["nmcli", "radio", "wifi", "off"])
    run_cmd(["nmcli", "radio", "wifi", "on"])
    import time; time.sleep(1)

def ensure_iface_up():
    r = run_cmd(["ip", "link", "show", WIFI_IFACE])
    if r and "state UP" not in r.stdout:
        run_cmd(["ip", "link", "set", WIFI_IFACE, "up"])
        import time; time.sleep(1)
    run_cmd(["rfkill", "unblock", "wlan"])

# ---------------------------------------------------------------------------
# USB tether: the phone gets internet from this laptop's Ethernet over the
# USB cable (Gnirehtet relay + Android VPN client). Zero Wi-Fi involved, so
# Bluetooth and Wi-Fi stop fighting over the 2.4 GHz band.
# ---------------------------------------------------------------------------
GNIREHTET_DIR = os.path.expanduser("~/.local/share/pop-hotspot/gnirehtet")
GNIREHTET_BIN = os.path.join(GNIREHTET_DIR, "gnirehtet")
GNIREHTET_PKG = "com.genymobile.gnirehtet"
TETHER_PID_FILE = os.path.join(CONFIG_DIR, "tether.pid")
TETHER_LOG_FILE = os.path.join(CONFIG_DIR, "tether.log")

def adb_devices():
    """Serials of adb devices that are authorised and ready."""
    r = run_cmd(["adb", "devices"], timeout=15)
    devs = []
    if r and r.returncode == 0:
        for line in (r.stdout or "").splitlines()[1:]:
            p = line.split()
            if len(p) >= 2 and p[1] == "device":
                devs.append(p[0])
    return devs

def tether_client_up():
    """True when the phone actually has the gnirehtet VPN interface up."""
    r = run_cmd(["adb", "shell", "ip", "-brief", "addr", "show", "tun0"], timeout=10)
    return bool(r and r.returncode == 0 and "10.0.0.2" in (r.stdout or ""))

def tether_relay_pid():
    try:
        pid = int(open(TETHER_PID_FILE).read().strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        return None

def tether_connections():
    """Approximate number of open tunnels (Open minus Close in the relay log)."""
    try:
        lines = open(TETHER_LOG_FILE, errors="ignore").read().splitlines()[-400:]
    except OSError:
        return 0
    return max(0, sum(" Open" in l for l in lines) - sum(" Close" in l for l in lines))

def tether_start():
    global last_error
    if not os.path.exists(GNIREHTET_BIN):
        last_error = f"gnirehtet engine missing at {GNIREHTET_DIR}"
        return False
    devs = adb_devices()
    if not devs:
        last_error = "No phone on USB — plug the cable in and allow USB debugging."
        return False
    serial = config.get("tether_serial") or devs[0]
    r = run_cmd(["adb", "shell", "pm", "list", "packages"], timeout=15)
    if not r or GNIREHTET_PKG not in (r.stdout or ""):
        run_cmd([GNIREHTET_BIN, "install", serial], timeout=120, cwd=GNIREHTET_DIR)
    if not tether_relay_pid():
        log = open(TETHER_LOG_FILE, "ab", buffering=0)
        p = subprocess.Popen([GNIREHTET_BIN, "relay"], cwd=GNIREHTET_DIR,
                             stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        open(TETHER_PID_FILE, "w").write(str(p.pid))
        time.sleep(1.5)
    # 8.8.8.8 is Gnirehtet's default; add a second resolver in case it is blocked
    dns = config.get("tether_dns") or "8.8.8.8,1.1.1.1"
    r = run_cmd([GNIREHTET_BIN, "restart", serial, "-d", dns], timeout=45, cwd=GNIREHTET_DIR)
    if not (r and r.returncode == 0):
        run_cmd([GNIREHTET_BIN, "start", serial, "-d", dns], timeout=30, cwd=GNIREHTET_DIR)
    for _ in range(24):
        if tether_client_up():
            last_error = ""
            return True
        time.sleep(0.5)
    last_error = ("Phone did not bring the tunnel up — accept the VPN request "
                  "on the phone screen, then try again.")
    return False

def tether_stop():
    global last_error
    devs = adb_devices()
    if devs:
        run_cmd([GNIREHTET_BIN, "stop", config.get("tether_serial") or devs[0]],
                timeout=20, cwd=GNIREHTET_DIR)
    pid = tether_relay_pid()
    if pid:
        try:
            os.kill(pid, 15)
        except Exception:
            pass
    try:
        os.remove(TETHER_PID_FILE)
    except OSError:
        pass
    last_error = ""
    return True

def turn_on_hotspot():
    global last_error
    # ── preferred backend: hostapd (TV-compatible) ──────────────────────────
    backend = config.get("backend", "hostapd")
    if backend == "hostapd" and hostapd_backend_available():
        write_hostapd_conf()
        r = run_cmd(["systemctl", "start", HOSTAPD_SERVICE], timeout=60)
        if r and r.returncode == 0 and hostapd_service_active():
            last_error = ""
            return True
        last_error = (r.stderr or "").strip().splitlines()[-1] if r and (r.stderr or "").strip() \
                     else "hostapd backend failed to start"
        # fall through to NetworkManager rather than leaving the user without a hotspot

    ensure_iface_up()
    if conn_exists():
        run_cmd(["nmcli", "connection", "delete", CONN_NAME])
    r = run_cmd([
        "nmcli", "connection", "add",
        "type", "wifi", "ifname", WIFI_IFACE,
        "con-name", CONN_NAME, "autoconnect", "no",
        "ssid", config["ssid"],
    ])
    if r and r.returncode == 0:
        modify_cmd = [
            "nmcli", "connection", "modify", CONN_NAME,
            "802-11-wireless.mode", "ap",
            "ipv4.method", "shared",
            "wifi-sec.key-mgmt", "wpa-psk",
            "wifi-sec.proto", "rsn",
            "wifi-sec.pairwise", "ccmp",
            "wifi-sec.group", "ccmp",
            "wifi-sec.psk", config["password"],
        ]
        band = config.get("band", "auto")
        chan = str(config.get("channel") or "auto").strip()
        if band == "a":
            usable, total, hint = ghz5_status()
            if chan in ("", "auto", "0"):
                chan = usable[0] if usable else "36"
            modify_cmd.extend(["802-11-wireless.band", "a",
                               "802-11-wireless.channel", chan])
        elif band != "auto":
            modify_cmd.extend(["802-11-wireless.band", band])
            if chan not in ("", "auto", "0"):
                modify_cmd.extend(["802-11-wireless.channel", chan])
        run_cmd(modify_cmd)
    up = run_cmd(["nmcli", "connection", "up", CONN_NAME], timeout=45)
    if up and up.returncode != 0:
        reset_wifi_iface()
        up = run_cmd(["nmcli", "connection", "up", CONN_NAME], timeout=45)
    ok = bool(up and up.returncode == 0)
    if ok:
        last_error = ""
    else:
        band = config.get("band", "auto")
        err = (up.stderr or "").strip().splitlines()[-1] if up and (up.stderr or "").strip() else "nmcli could not activate the hotspot"
        if band == "a":
            usable, total, hint = ghz5_status()
            last_error = (f"5 GHz could not start: {hint} " if not usable else f"5 GHz could not start: {err} ") + \
                         "See Settings → Prepare 5 GHz."
        else:
            last_error = err
    apply_iptables_block()
    return ok

def turn_off_hotspot():
    if hostapd_service_active():
        r = run_cmd(["systemctl", "stop", HOSTAPD_SERVICE], timeout=60)
        clear_iptables_block()
        return bool(r and r.returncode == 0)
    r = run_cmd(["nmcli", "connection", "down", CONN_NAME])
    clear_iptables_block()
    return r and r.returncode == 0

