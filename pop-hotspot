    def on_destroy(self, w):
        if not config.get("tether_persist", False) and (tether_client_up() or tether_relay_pid()):
            tether_stop()
        Gtk.main_quit()

    def poll_tether(self):
        self.update_tether_ui()
        return True

    def on_cast(self, button):
        """Launch pop-cast: it stops the hotspot, runs the Miracast caster, and
        restores the hotspot when the casting window is closed."""
        script = os.path.expanduser("~/.local/bin/pop-cast")
        if not os.path.exists(script):
            self.cast_label.set_markup("<small>pop-cast is not installed.</small>")
            return
        try:
            subprocess.Popen([script], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            self.cast_label.set_markup(
                "<small>Started — pick your TV in the window that opened. The hotspot "
                "returns when you close it.</small>")
        except Exception as e:  # noqa: BLE001 — surface any launch failure in the UI
            self.cast_label.set_markup(f"<small>Could not start casting: {e}</small>")

    def on_tether_switch(self, switch, gparam):
        if not switch.get_sensitive():
            return
        self.tether_switch.set_sensitive(False)
        target = switch.get_active()
        self.tether_label.set_markup(f"<b>⏳ {'Starting' if target else 'Stopping'}…</b>")
        def worker():
            ok = tether_start() if target else tether_stop()
            if not ok:
                GLib.idle_add(self._dialog, "USB Tether", last_error)
            GLib.idle_add(self.update_tether_ui)
        threading.Thread(target=worker, daemon=True).start()

    def update_tether_ui(self):
        active = tether_client_up()
        if active:
            n = tether_connections()
            self.tether_label.set_markup(
                "<b>🟢 Active</b>" + (f" — {n} open connection{'s' if n != 1 else ''}" if n else ""))
        else:
            self.tether_label.set_markup("<b>🔴 Off</b>")
        self.tether_switch.handler_block_by_func(self.on_tether_switch)
        self.tether_switch.set_active(active)
        self.tether_switch.handler_unblock_by_func(self.on_tether_switch)
        self.tether_switch.set_sensitive(True)
        return False

    def update_ghz5_label(self):
        usable, total, hint = ghz5_status()
        if usable:
            self.ghz5_label.set_markup(
                f"<small>5 GHz: <b>ready</b> (channels {', '.join(usable[:5])})</small>")
        elif total:
            self.ghz5_label.set_markup(
                f"<small>5 GHz: <b>blocked by driver</b> — all {total} channels are “no IR”</small>")
        else:
            self.ghz5_label.set_markup("<small>5 GHz: card reports none</small>")

    def prepare_5ghz(self, w):
        """Ask for the admin password once: stop the AP, scan every band so the
        driver can learn the country, then report what this card actually allows."""
        script = ("nmcli connection down PopHotspot >/dev/null 2>&1; "
                  f"ip link set {WIFI_IFACE} up; sleep 1; "
                  f"{{ iw dev {WIFI_IFACE} scan; iw reg get; iw list; dmesg; }} "
                  "> /tmp/pop-hotspot-5ghz.txt 2>&1; chmod 644 /tmp/pop-hotspot-5ghz.txt")
        try:
            subprocess.Popen(["pkexec", "bash", "-c", script])
        except FileNotFoundError:
            self._dialog("pkexec not available",
                         "Run this in a terminal instead:\n\nsudo bash -c '%s'" % script)
            return
        GLib.timeout_add_seconds(8, self._after_prepare)

    def _after_prepare(self):
        try:
            txt = open("/tmp/pop-hotspot-5ghz.txt").read()
        except OSError:
            self._dialog("5 GHz check", "No result file — did the admin prompt get cancelled?")
            return False
        heard = len(re.findall(r"^freq: 5\d{3}", txt, re.M))
        usable, total, hint = ghz5_status()
        self.update_ghz5_label()
        msg = (f"5 GHz access points heard while scanning: {heard}\n"
               f"Channels usable for a 5 GHz hotspot: "
               f"{', '.join(usable) if usable else 'none (' + str(total) + ' × “no IR”)'}")
        if not usable:
            msg += ("\n\n" + hint +
                    "\n\nOptions: use a 5 GHz-capable USB Wi-Fi adapter, or stay on "
                    "2.4 GHz and switch Bluetooth off while you need throughput.")
        self._dialog("5 GHz check", msg)
        return False

    def _dialog(self, title, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=title)
        d.format_secondary_text(text)
        d.run(); d.destroy()

    def is_active(self):
        return is_hotspot_active()

    def conn_exists(self):
        return conn_exists()

    def refresh(self, polling=False):
        active = self.is_active()
        self.status_label.set_markup(
            f"<b>{'🟢 Active' if active else '🔴 Inactive'}</b>"
        )
        self.switch.handler_block_by_func(self.on_switch)
        self.switch.set_active(active)
        self.switch.handler_unblock_by_func(self.on_switch)
        if not polling:
            self.switch.set_sensitive(True)
        self.refresh_clients()
        return False

    def refresh_clients(self):
        if not self.is_active():
            self.clients_store.clear()
            return True
        clients = get_clients()
        self.clients_store.clear()
        for mac, info in clients.items():
            is_blk = mac in self.blocked_set
            self.clients_store.append([
                mac,
                info.get("ip", "") or "N/A",
                info.get("signal", ""),
                f"TX:{info.get('tx','?')} RX:{info.get('rx','?')}",
                str(is_blk).lower(),
            ])
        return True

    def refresh_blocked(self):
        self.blocked_store.clear()
        for mac in sorted(self.blocked_set):
            self.blocked_store.append([mac])

    def poll_operation(self, target_active, tries=0):
        if tries > 30:
            actual = self.is_active()
            detail = f"\n<small>{last_error}</small>" if last_error else ""
            self.status_label.set_markup(
                f"<b>⚠️ Timed out</b>{detail}"
            )
            self.switch.set_sensitive(True)
            self.switch.handler_block_by_func(self.on_switch)
            self.switch.set_active(actual)
            self.switch.handler_unblock_by_func(self.on_switch)
            return False
        if self.is_active() == target_active:
            self.refresh()
            return False
        self.status_label.set_markup(
            f"<b>⏳ {'Starting' if target_active else 'Stopping'}...</b>"
        )
        GLib.timeout_add(800, self.poll_operation, target_active, tries + 1)
        return False

    def on_switch(self, switch, gparam):
        if not switch.get_sensitive():
            return
        self.switch.set_sensitive(False)
        target = switch.get_active()
        self.status_label.set_markup(
            f"<b>⏳ {'Starting' if target else 'Stopping'}...</b>"
        )
        def blocking():
            if target:
                turn_on_hotspot()
            else:
                turn_off_hotspot()
            GLib.idle_add(self.poll_operation, target, 0)
        threading.Thread(target=blocking, daemon=True).start()

    def on_block_toggled(self, renderer, path, col):
        mac = self.clients_store[path][0]
        if mac in self.blocked_set:
            self.blocked_set.discard(mac)
            blocked[:] = list(self.blocked_set)
            save_json(BLOCKED_FILE, blocked)
            apply_iptables_block()
        else:
            self.block_confirm_mac = mac
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.YES_NO,
                text=f"Block {mac}?",
            )
            dialog.format_secondary_text(
                "This client will be disconnected and blocked from the hotspot."
            )
            resp = dialog.run()
            dialog.destroy()
            if resp == Gtk.ResponseType.YES:
                self.blocked_set.add(mac)
                blocked[:] = list(self.blocked_set)
                save_json(BLOCKED_FILE, blocked)
                deauth_client(mac)
                apply_iptables_block()
        self.refresh_clients()
        self.refresh_blocked()

    def on_unblock_toggled(self, renderer, path):
        mac = self.blocked_store[path][0]
        self.blocked_set.discard(mac)
        blocked[:] = list(self.blocked_set)
        save_json(BLOCKED_FILE, blocked)
        apply_iptables_block()
        self.refresh_blocked()
        self.refresh_clients()

    def save_settings(self, w):
        new_ssid = self.ssid_entry.get_text().strip()
        new_pass = self.pass_entry.get_text().strip()
        if not new_ssid or not new_pass:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK,
                text="SSID and password cannot be empty.")
            dialog.run(); dialog.destroy()
            return
        if len(new_pass) < 8:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK,
                text="Password must be at least 8 characters.")
            dialog.run(); dialog.destroy()
            return
        was_active = self.is_active()
        if was_active:
            turn_off_hotspot()
        config["ssid"] = new_ssid
        config["password"] = new_pass
        config["band"] = self.band_combo.get_active_id() or "auto"
        config["channel"] = self.chan_combo.get_active_id() or "auto"
        config["backend"] = self.backend_combo.get_active_id() or "hostapd"
        config["tether_persist"] = bool(self.persist_check.get_active())
        save_json(CONFIG_FILE, config)
        if was_active:
            turn_on_hotspot()
        self.update_ghz5_label()
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK,
            text="Settings saved. Hotspot recreated.")
        dialog.run(); dialog.destroy()
        self.refresh()

